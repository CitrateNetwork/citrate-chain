# Citrate Faucet Configuration
# Copy to .env and fill in values

# RPC endpoint for the Citrate node
CITRATE_RPC_URL=http://localhost:8545

# Chain ID (40204 for testnet)
CITRATE_CHAIN_ID=40204

# Port for the faucet HTTP server
FAUCET_PORT=3002

# Faucet address (must be funded with SALT)
FAUCET_ADDRESS=0x3333333333333333333333333333333333333333

# Optional: API key for authenticated RPC
# CITRATE_API_KEY=your-api-key

# Optional: Comma-separated whitelist of allowed addresses
# FAUCET_WHITELIST=0xaddr1,0xaddr2

# ---------------------------------------------------------------------------
# HUP-S6.5 / federation F-5 (faucet ADR O-1..O-4, pending owner sign-off).
# Every setting below is OFF unless set. Leaving them unset keeps the faucet
# exactly as it was. The suggested values are conservative placeholders.
# ---------------------------------------------------------------------------

# Optional: faucet-wide cap on drips per sliding hour (1..100000). Unset = no cap.
# Placeholder pending owner sign-off (O-1): 60
# FAUCET_MAX_DRIPS_PER_HOUR=60

# Optional: drip only to holders of the membership SBT (ERC-721 balanceOf > 0).
# Use the CitrateMemberSBT address from the current 40204 address book (it moves
# on every reroll). Fails closed when the RPC cannot answer. Pending owner sign-off (O-2).
# FAUCET_MEMBER_SBT=0x...

# Optional: CAPTCHA page. Set the public site key TOGETHER with
# FAUCET_TURNSTILE_SECRET; the faucet refuses to start with only the site key.
# FAUCET_TURNSTILE_SITE_KEY=...

# Optional: let the Citrate Core desktop app's webview call the faucet (CORS).
# Only these exact values are accepted: tauri://localhost, http://tauri.localhost,
# https://tauri.localhost. Pending owner sign-off (O-3).
# FAUCET_DESKTOP_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost
