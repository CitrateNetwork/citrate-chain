# Citrate Faucet Configuration
# Copy to .env and fill in values

# RPC endpoint for the Citrate node
CITRATE_RPC_URL=http://localhost:8545

# Chain ID (40204 for testnet)
CITRATE_CHAIN_ID=40204

# Port for the faucet HTTP server
FAUCET_PORT=3002

# Faucet address (must be funded with SALT)
FAUCET_ADDRESS=0x3333333333333333333333333333333333333333

# Optional: API key for authenticated RPC
# CITRATE_API_KEY=your-api-key

# Optional: Comma-separated whitelist of allowed addresses
# FAUCET_WHITELIST=0xaddr1,0xaddr2
