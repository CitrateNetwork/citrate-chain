# Rust build artifacts
target/
**/*.rs.bk
Cargo.lock.bak

# Foundry / Solidity compilation
out/
cache/

# Foundry broadcast (allow root /broadcast manifest but ignore deployments)
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Local devnet / state
.citrate-devnet/
.citrate-*/
run-logs/
dist/
release/
releases/

# Test artifacts
**/test-output/
test-reports/

# IDE
.idea/
.vscode/*
!.vscode/settings.json.example
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.*
!.env.example

# Bootnode noise keypairs (X25519 private || public, 64 bytes).
# Generated by `cargo run --example gen_bootnode_keys -p citrate-network`.
# These are PRIVATE keys — never commit. Uploaded to droplet data dirs
# (/home/citrate/.citrate/noise.key) during bootnode provisioning so
# baked-in peer IDs in node/config/testnet-beta.toml stay stable.
tools/bootnode-keys/*.noise.key

# Node (in case any contracts dir uses npm)
node_modules/

# Logs
*.log
logs/

# TLA+ model checker output (regenerable)
**/states/
**/*.st
**/*.fp

# Python virtual envs (in case tools/ has pyenvs)
.venv/
venv/
__pycache__/
*.pyc

# Coverage
*.profraw
*.profdata
lcov.info
coverage/

# TLC model checker (auto-downloaded by specs/tla/run_all.sh)
specs/tla/tla2tools.jar

# Foundry deploy logs — regenerated on every deploy; reroll clears them.
# Durable address record is contracts/addresses/40204.json, not raw broadcasts.
contracts/broadcast/

# Local Claude Code state (agent worktrees, session data) — never commit.
.claude/

