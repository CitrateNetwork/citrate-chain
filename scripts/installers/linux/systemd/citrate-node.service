[Unit]
Description=Citrate Blockchain Node
Documentation=https://docs.citrate.ai
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=citrate
Group=citrate
ExecStart=/usr/bin/citrate-node devnet
WorkingDirectory=/var/lib/citrate
Restart=on-failure
RestartSec=10
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier=citrate-node

Environment=CITRATE_DATA_DIR=/var/lib/citrate
Environment=RUST_LOG=info
Environment=CITRATE_METRICS_ADDR=127.0.0.1:9090

[Install]
WantedBy=multi-user.target
