<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.citrate.node</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/Citrate.app/Contents/MacOS/citrate-node</string>
        <string>devnet</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>WorkingDirectory</key>
    <string>/Users/Shared/.citrate</string>
    <key>StandardOutPath</key>
    <string>/Users/Shared/.citrate/logs/node.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/Shared/.citrate/logs/node-error.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>CITRATE_DATA_DIR</key>
        <string>/Users/Shared/.citrate</string>
        <key>RUST_LOG</key>
        <string>info</string>
    </dict>
</dict>
</plist>
