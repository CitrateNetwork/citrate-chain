# 0.6.0 ceremony genesis. WorkMarket coordinator bonds, SALT wei: 100 SALT minimum, 1,000 default.
WORKMARKET_MIN_COORDINATOR_BOND=100000000000000000000
WORKMARKET_DEFAULT_COORDINATOR_BOND=1000000000000000000000
# DECIDED (owner 2026-11-11), fixed in code (not inputs): the GUARDIAN timelock is the acting
# address in all three block-0 guardian seats (WorkMarket, ProviderRegistry, GuardianCancellerV2);
# the 24 h ProviderRegistry veto window and the 90-day UsageReceipts backfill (chain #400 profile);
# DeployV060Genesis runs as ceremony phase P4V, between P4 and P5.
